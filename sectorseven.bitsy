NAME tea
DLG 1

DLG 0
"""
{
  - spoke_to_term == false ?
    GREETINGS. I AM A WORMHOLE TRANSPORTATION INTERFACE.{pg}IF YOU ARE READY TO PROCEED THROUGH THE WORMHOLE,
    CONFIRM BY ACTIVITING ME ONCE MORE.
    TO BOOST TRAVERSAL PROBABILITY COEFFICIENT,
    PLUG POWER CELLS INTO THE BOOST PANEL BELOW{spoke_to_term = true}
  - else ?
    {target_sector = current_sector + 1}WORMHOLE TRAVERSAL INITIATED.{pg}CALCULATING COORDINATES...{pg}ADJUSTING PROBABILITY VECTORS...{pg}{
      - boost_add > 0 ?
        ADDING BOOST FACTOR OF {say boost_add}...{spoke_to_boost = false}{pg}
    }ACTIVATING TRAVERSAL ENGINE.{pg}APPROACHING WORMHOLE IN{pg}3...{pg}2...{pg}1...{pg}...{pg}{rbw}{wvy}ENTERING WORMHOLE{/wvy}{/rbw}{pg}{spoke_to_term = false}{shuffle
      - {move_roll = 1}
      - {move_roll = 2}
      - {move_roll = 3}
      - {move_roll = 4}
      - {move_roll = 5}
      - {move_roll = 6}
    }{move_roll = move_roll + boost_add}{boost_add = 0}{
      - move_roll >= move_cost ?
        {move_success = true}
      - else ?
        {move_success = false}{target_sector = current_sector}
    }{
      - target_sector == 1 ?
        {target_name = "sector_01"}
      - target_sector == 2 ?
        {target_name = "sector_02"}
      - target_sector == 3 ?
        {target_name = "sector_03"}
      - target_sector == 4 ?
        {target_name = "sector_04"}
      - target_sector == 5 ?
        {target_name = "sector_05"}
      - target_sector == 6 ?
        {target_name = "sector_06"}
      - target_sector == 7 ?
        {target_name = "sector_07"}
    }{exit target_name 6 8 "wave"}{current_sector = target_sector}TRAVERSAL COMPLETE.{pg}RESULT:{pg}{
      - move_success == true ?
        {rbw}{wvy}SUCCESS.{/wvy}{/rbw}
      - else ?
        ...{pg}ERROR
        ERROR
        {shk}ERROR{/shk}{pg}WORMHOLE TRAVERSAL FAILURE.
    }{
      - current_sector == 7 ?
        {rbw}{wvy}YOU MADE IT!{/wvy}{/rbw}
      - else ?
        {pg}NAVIGATING SHIP TOWARD NEXT LOCAL WORMHOLE.{pg}{shuffle
          - {took_damage = false}
          - {took_damage = true}
        }{
          - took_damage == true ?
            {ship_power = ship_power - 1}{shk}*BOOM!*{/shk}{pg}...{pg}ATTENTION! ATTENTION!
            HULL DAMAGE DETECTED!{pg}REDIRECTING POWER TO SHIELD.{pg}SHIP POWER LEVEL IS NOW {say ship_power}.
          - else ?
            {
              - ship_power > 0 ?
                ...{pg}NAVIGATION COMPLETE.
                SHIP HAS ARRIVED AT LOCAL WORMHOLE FOR THIS SECTOR.
              - else ?
                POWER LEVEL IS NOW 0.
                SHIP SYSTEMS SHUTTING DOWN...{pg}[GAME OVER...]
            }
        }
    }
}
"""
NAME term_dialog

DLG 1
You found a nice warm cup of tea
NAME tea dialog

DLG 2
"""
SHIP STATUS:
LOCATION: {clr 1}SECTOR {say current_sector}
{/clr}POWER: {clr 1}{say ship_power}{/clr}
{
  - ship_power >= ship_good ?
    SYSTEMS: {clr 1}GOOD{/clr}
  - else ?
    {
      - ship_power >= ship_ok ?
        SYSTEMS: OK{pg}MINOR HULL DAMAGE DETECTED.
        CAUTION ADVISED.
      - else ?
        SYSTEMS: {clr 2}CRITICAL{/clr}{pg}MAJOR HULL DAMAGE DETECTED.
        SYSTEM FAILURE IMMINENT.
        REPLENISH POWER AS SOON AS POSSIBLE.
    }
}
"""
NAME computer_dialog

DLG 3
"""
{
  - ship_power > 1 ?
    {
      - spoke_to_boost == false ?
        ADD POWER CELL?{pg}ACTIVATE THIS PANEL AGAIN TO CONFIRM.{spoke_to_boost = true}
      - else ?
        {ship_power = ship_power - 1}{boost_add = boost_add + 1}ADDED POWER CELL TO TRAVERSAL DRIVE.{pg}SHIP POWER LEVEL IS NOW {say ship_power}.{spoke_to_boost = false}
    }
  - else ?
    ERROR: SHIP POWER LEVEL TOO LOW.
    CANNOT ADD LAST REMAINING FUEL CELL TO TRAVERSAL DRIVE.
}
